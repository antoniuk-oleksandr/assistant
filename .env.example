# See docs/drive.md for the Drive OAuth scopes and setup.
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# GOOGLE_DRIVE_MATERIAL_DIR=

# Google Classroom OAuth. Store the refresh token; the application refreshes
# short-lived access tokens automatically.
# GOOGLE_CLASSROOM_OAUTH_CLIENT_ID=
# GOOGLE_CLASSROOM_OAUTH_CLIENT_SECRET=
# GOOGLE_CLASSROOM_OAUTH_REFRESH_TOKEN=
# Timezone used when interpreting Classroom due dates and times.
# GOOGLE_CLASSROOM_TIMEZONE=Europe/Kyiv

# Google Sheets report output. The default renderer is google-sheets.
# REPORT_RENDERER=google-sheets
# GOOGLE_SHEETS_REPORT_TITLE=Scientific activity report
# GOOGLE_SHEETS_BASE_URL=https://sheets.googleapis.com/v4
# GOOGLE_SHEETS_OAUTH_CLIENT_ID=
# GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=
# GOOGLE_SHEETS_OAUTH_REFRESH_TOKEN=

# Report-ready email through Resend.
# Create an API key in the Resend dashboard: https://resend.com/api-keys
# RESEND_API_KEY=
# REPORT_TARGET_EMAIL=owner@example.com
# Use onboarding@resend.dev for the Resend account owner during testing, or a
# sender address from a verified Resend domain for production.
# RESEND_FROM=onboarding@resend.dev
# RESEND_BASE_URL=https://api.resend.com
# REPORT_READY_EMAIL_TEMPLATE=templates/report-ready-email.txt
# REMINDER_TEMPLATE_PATH=templates/missing-submission-reminder.txt
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BASE_URL=https://api.telegram.org
