FROM golang:1.20-bookworm AS go-tools

RUN go install golang.org/x/tools/gopls@v0.12.4

FROM nousresearch/hermes-agent:latest

COPY --from=go-tools /usr/local/go /usr/local/go
COPY --from=go-tools /go/bin/gopls /usr/local/bin/gopls

# Hermes terminal subprocesses may provide a minimal PATH. Keep Go installed
# in the image and expose the compiler tools through a directory that remains
# available in that environment.
RUN ln -sf /usr/local/go/bin/go /usr/local/bin/go \
    && ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt

RUN python -m ensurepip --upgrade \
    && python -m pip install --no-cache-dir graphifyy

ENV PATH="/usr/local/go/bin:/usr/local/bin:/opt/hermes/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}"
ENV HERMES_WRITE_SAFE_ROOT=/workspace
